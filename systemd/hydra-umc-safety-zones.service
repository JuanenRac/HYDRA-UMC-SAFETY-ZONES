# Loopback-only, same as every other internal-only API on this CM5 - this
# real check/E-STOP-request logic never asserts an E-STOP itself
# (NullEStopRequester, same as the CLI), it only ever requests one for a
# real transport to actually assert, but it still has no authentication
# of its own, so it stays unreachable from the wider LAN.
[Unit]
Description=HYDRA-UMC-SAFETY-ZONES real intrusion-detection/E-STOP-request API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-safety-zones
Group=hydra-umc-safety-zones
WorkingDirectory=/opt/hydra-umc/safety-zones
Environment=PYTHONPATH=/opt/hydra-umc/safety-zones/src
# The zones are fixed on this machine (serve does not start without them): /etc/hydra-umc-safety-zones/zones.json, made from
# docs/zones.separation.example.json. That directory belongs to this service alone (systemd creates it, mode 0750, for this account), so the shared
# /etc/hydra-umc directory, which only the group of the agent may enter, is not touched. A zones file of the earlier layout
# (/etc/hydra-umc/safety-zones.zones.json) is copied there once, as root, by the first ExecStartPre, which never overwrites and never deletes.
# A token, if any, goes in /etc/hydra-umc-safety-zones/safety-zones.env (or the earlier /etc/hydra-umc/safety-zones.env) as SAFETY_ZONES_TOKEN=...
# systemd reads both as root. Without a readable zones file the service does not start: that is the safe state.
ConfigurationDirectory=hydra-umc-safety-zones
ConfigurationDirectoryMode=0750
EnvironmentFile=-/etc/hydra-umc/safety-zones.env
EnvironmentFile=-/etc/hydra-umc-safety-zones/safety-zones.env
ExecStartPre=+/usr/bin/python3 -m hydra_umc_safety_zones.main prepare-config --zones-file /etc/hydra-umc-safety-zones/zones.json --legacy-file /etc/hydra-umc/safety-zones.zones.json
ExecStartPre=/usr/bin/python3 -m hydra_umc_safety_zones.main check-access --zones-file /etc/hydra-umc-safety-zones/zones.json
ExecStart=/usr/bin/python3 -m hydra_umc_safety_zones.main serve --addr 127.0.0.1 --port 8108 --zones-file /etc/hydra-umc-safety-zones/zones.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# A real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryAccounting=yes
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
